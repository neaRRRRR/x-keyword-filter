{
  "manifest_version": 3,
  "name": "GTA VI Filtresi · X",
  "version": "1.0.0",
  "description": "X'te GTA VI ile ilgili gönderileri ve alıntıları bulanıklaştırır veya kaldırır.",
  "minimum_chrome_version": "105",
  "permissions": ["storage", "unlimitedStorage"],
  "action": {
    "default_title": "GTA VI filtresi",
    "default_popup": "settings.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://x.com/*",
        "https://www.x.com/*",
        "https://twitter.com/*",
        "https://www.twitter.com/*"
      ],
      "css": ["content.css"],
      "js": ["keywords.js", "content.js"],
      "run_at": "document_start"
    }
  ]
}
