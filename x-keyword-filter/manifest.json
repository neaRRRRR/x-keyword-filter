{
  "manifest_version": 3,
  "name": "X Kelime Filtresi",
  "version": "1.1.0",
  "description": "X gönderilerini ve alıntılarını kelime listelerine göre bulanıklaştırır veya kaldırır.",
  "minimum_chrome_version": "105",
  "permissions": ["storage", "unlimitedStorage"],
  "action": {
    "default_title": "X Kelime Filtresi",
    "default_popup": "settings.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://x.com/*",
        "https://www.x.com/*",
        "https://twitter.com/*",
        "https://www.twitter.com/*"
      ],
      "css": ["content.css"],
      "js": ["preferences.js", "content.js"],
      "run_at": "document_start"
    }
  ]
}
